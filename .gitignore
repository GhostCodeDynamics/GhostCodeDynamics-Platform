# GhostCode Dynamics Platform — root .gitignore
# Monorepo: Frontend/, Backend/, Admin-Panel/
#
# Patterns here are an umbrella in addition to each app's own .gitignore.

# Dependencies
node_modules/

# Build output
dist/
build/

# Test coverage
coverage/

# Environment files
# Real .env files are never committed. .env.example files ARE committed
# (both at repo root and inside each app).
.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# Temp / cache / backup
*.tmp
*.bak
*.orig
.cache/
.tmp/