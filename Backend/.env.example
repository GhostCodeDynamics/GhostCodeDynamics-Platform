# GhostCode Dynamics Backend environment configuration.
# Copy this file to .env and fill in real values. Never commit .env.
#
# Production: set NODE_ENV=production. validateEnv (src/config/validateEnv.js)
# then fails fast if MONGO_URI, CORS_ORIGIN, JWT_ACCESS_SECRET or ADMIN_EMAIL
# are missing, and warns when SMTP/Cloudinary are unconfigured.

NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
# In production: comma-separated browser origins only (never "*").
# CORS is credential-enabled (credentials: true), so the allow-list must name
# every deployed frontend origin, e.g. the site AND the admin panel:
# CORS_ORIGIN=https://ghostcodedynamics.com,https://admin.ghostcodedynamics.com
FRONTEND_URL=http://localhost:5173
MONGO_URI=mongodb://127.0.0.1:27017/ghostcode_dynamics

# ---- Cloudinary (admin image uploads) -------------------------------------
# Admin-only image uploads go straight from the backend to Cloudinary; the
# API secret NEVER reaches the browser. Get these from the Cloudinary
# dashboard (Settings > API Keys).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Admin namespace (auth) ------------------------------------------------
# JWT signing secret for admin ACCESS tokens. REQUIRED for /api/admin auth.
# Generate e.g. with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-char-random-secret
ACCESS_TOKEN_TTL=15m
REFRESH_TTL_DAYS=7
# Cookie policy for the httpOnly refresh cookie. strict|lax|none (none needs COOKIE_SECURE=true)
#   - Same-origin / reverse-proxied admin and API: keep strict.
#   - Cross-origin production (admin on a different domain than the API):
#     the refresh cookie must cross the origin boundary, so use none + Secure.
#     This is the ONLY reason to set COOKIE_SAMESITE=none.
COOKIE_SAMESITE=strict
COOKIE_SECURE=false

# Initial admin provisioning (used ONLY by: npm run create-admin).
# Set these in your real .env, never commit them.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional display name stored on the admin account (defaults to "Administrator").
# ADMIN_NAME=

# Optional: seed the 8 legacy blog posts + 4 portfolio projects.
#   MONGO_URI="<connection string>" npm run seed
# Idempotent (upserts by slug); safe to run repeatedly. Does not import
# engagement counters or placeholder GitHub URLs.

# Extra allowed browser origin(s) for the admin panel, comma-separated:
# CORS_ORIGIN=https://ghostcodedynamics.github.io,https://admin.example.com

# ---- SMTP / Email Configuration -------------------------------------------
# Used by the email service for transactional emails (contact acknowledgements,
# newsletter welcome, etc.). If left empty, email sending is silently skipped
# and the application continues normally.
#
# Gmail SMTP setup:
#   Host:     smtp.gmail.com
#   Port:     587
#   Secure:   false
#   Auth:     Use a Gmail App Password (NOT your regular password).
#             Enable 2-Step Verification, then generate an App Password at:
#             https://myaccount.google.com/apppasswords
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="GhostCode Dynamics <your-email@gmail.com>"
# Optional: recipient used by scripts/smtp-e2e-test.mjs for its real send
# test. Defaults to SMTP_USER when unset. Never put personal inboxes here.
# SMTP_TEST_TO=
