# GhostCode Dynamics — Website Frontend environment variables
# Copy this file to .env and fill in values. Vite exposes only VITE_* vars to
# the browser — never put CLOUDINARY_API_SECRET, JWT_SECRET or MONGO_URI here.

# Absolute public URL of the deployed site (used for SEO/sitemap/OG tags).
# Leave unset in local dev.
VITE_SITE_URL=https://ghostcode-dynamics.example

# Backend API base URL. Leave UNSET in local dev: the Vite dev server proxies
# /api to http://localhost:5000 (see vite.config.js) so the browser stays
# same-origin and no CORS config is needed. For a deployed build, set this to
# the absolute public API URL (e.g. https://api.example.com/api).
# VITE_API_BASE_URL=https://api.example.com/api
